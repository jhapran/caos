# IMP-011 — Client-safe environment template (OPS-ENV-02).
# Copy to .env.local for local development. NEVER commit real values.
# Only browser-safe values belong here: the publishable anon key and the
# public project URL. Service-role keys, database URLs, and any other
# secret are server-only and must never appear in src/ or .env files used
# by the Vite bundle.

# Data source selection (MIG-DS-01/02):
#   fixture  — demo track, no backend (default when unset)
#   supabase — production architecture; requires the two values below
VITE_DATA_SOURCE=fixture

# Required when VITE_DATA_SOURCE=supabase (MIG-DS-03: missing values are a
# hard startup error — no fallback). Local development values come from
# `npx supabase status -o env` (API_URL / ANON_KEY) while the local stack
# is running. Do NOT point these at hosted Supabase from a local checkout
# unless you are explicitly doing staging work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
